// Prisma Schema for Shirol Nagar Seva (MySQL Database)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  role      String   // "admin", "mayor", "officer", "citizen"
  uniqueId  String?  @unique
  phone     String?
  email     String?
  ward      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Complaint {
  id          String   @id @default(uuid())
  date        String
  citizenName String
  category    String
  description String   @db.Text
  ward        String
  area        String?
  image       String?  @db.LongText
  status      String   @default("Pending") // "Pending", "In Progress", "Resolved"
  assignedTo  String?
  timeline    Json?    // Array of status history updates
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id          String   @id @default(uuid())
  name        String
  head        String
  budget      String
  activeStaff Int      @default(0)
  icon        String   @default("Building")
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DepartmentEmployee {
  id             String   @id @default(uuid())
  name           String
  departmentId   String
  departmentName String
  designation    String
  email          String
  phone          String
  status         String   @default("Active")
  joinedDate     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
